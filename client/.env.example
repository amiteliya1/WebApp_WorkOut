# Server Environment Variables
# Copy this file to .env and fill in your values

# Server Port (default: 3002)
PORT=3002

# MongoDB Atlas Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
# Replace username, password, cluster, and database with your actual values
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/workout-tracker?retryWrites=true&w=majority

# JWT Secret (use a strong random string in production)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# JWT Expiration (default: 7d)
JWT_EXPIRES_IN=7d

# YouTube API Key (optional, for video library proxy)
YOUTUBE_API_KEY=your_youtube_api_key_here
